// Smart Folio — Database Schema
//
// Conventions:
//  - Money / quantity / price / rate fields use `Decimal` (never Float) so
//    financial engines never lose precision to floating point rounding.
//    Rounding for display happens only in the UI layer (spec §54).
//  - Weights are stored as decimals (0..1), never as pre-rounded percents.
//  - All timestamps are stored in UTC (spec §55); the UI converts to the
//    viewer's local time zone at render time.
//  - Every portfolio-scoped row carries (directly or via Portfolio) a
//    `userId` path so access can be isolated per user (spec §3).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth (Auth.js / NextAuth — Prisma adapter). See ADR in README for why
// Auth.js + Prisma was chosen over Supabase Auth (no Supabase project keys
// were available; this keeps auth self-hosted behind DATABASE_URL only).
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  portfolios Portfolio[]
  watchlist  WatchlistItem[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Core portfolio domain
// ---------------------------------------------------------------------------

model Portfolio {
  id           String   @id @default(cuid())
  userId       String
  name         String
  baseCurrency String   @default("USD")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  securities       PortfolioSecurity[]
  transactions     Transaction[]
  snapshots        PortfolioSnapshot[]
  riskSnapshots    RiskSnapshot[]
  savedScenarios   SavedScenario[]
  investmentPlan   InvestmentPlan?
  alertPreferences AlertPreference[]

  @@index([userId])
  @@map("portfolios")
}

enum SecurityType {
  EQUITY
  ETF
  MUTUAL_FUND
  BOND
  CRYPTO
  CASH
  OTHER
}

model Security {
  id           String       @id @default(cuid())
  ticker       String
  name         String
  exchange     String
  currency     String
  securityType SecurityType @default(EQUITY)
  sector       String?
  industry     String?
  country      String?
  isin         String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  portfolios    PortfolioSecurity[]
  transactions  Transaction[]
  marketPrices  MarketPrice[]
  watchlistedBy WatchlistItem[]

  @@unique([ticker, exchange])
  @@index([ticker])
  @@map("securities")
}

model PortfolioSecurity {
  portfolioId String
  securityId  String
  addedAt     DateTime @default(now())

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  security  Security  @relation(fields: [securityId], references: [id], onDelete: Cascade)

  @@id([portfolioId, securityId])
  @@map("portfolio_securities")
}

enum TransactionType {
  BUY
  SELL
  DIVIDEND
  DEPOSIT
  WITHDRAWAL
  FEE
}

model Transaction {
  id              String          @id @default(cuid())
  portfolioId     String
  securityId      String?
  transactionType TransactionType
  date            DateTime
  quantity        Decimal?        @db.Decimal(24, 8)
  price           Decimal?        @db.Decimal(24, 8)
  currency        String
  fees            Decimal         @default(0) @db.Decimal(20, 4)
  tax             Decimal         @default(0) @db.Decimal(20, 4)
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  security  Security? @relation(fields: [securityId], references: [id])

  @@index([portfolioId, date])
  @@index([securityId])
  @@map("transactions")
}

// ---------------------------------------------------------------------------
// Market data
// ---------------------------------------------------------------------------

model MarketPrice {
  id             String   @id @default(cuid())
  securityId     String
  date           DateTime @db.Date
  open           Decimal? @db.Decimal(24, 8)
  high           Decimal? @db.Decimal(24, 8)
  low            Decimal? @db.Decimal(24, 8)
  close          Decimal  @db.Decimal(24, 8)
  adjustedClose  Decimal? @db.Decimal(24, 8)
  volume         BigInt?
  currency       String

  security Security @relation(fields: [securityId], references: [id], onDelete: Cascade)

  @@unique([securityId, date])
  @@index([securityId])
  @@map("market_prices")
}

model ExchangeRate {
  id            String   @id @default(cuid())
  baseCurrency  String
  quoteCurrency String
  date          DateTime @db.Date
  rate          Decimal  @db.Decimal(24, 10)

  @@unique([baseCurrency, quoteCurrency, date])
  @@map("exchange_rates")
}

model Benchmark {
  id       String @id @default(cuid())
  symbol   String @unique
  name     String
  currency String

  prices BenchmarkPrice[]

  @@map("benchmarks")
}

model BenchmarkPrice {
  id          String   @id @default(cuid())
  benchmarkId String
  date        DateTime @db.Date
  close       Decimal  @db.Decimal(24, 8)

  benchmark Benchmark @relation(fields: [benchmarkId], references: [id], onDelete: Cascade)

  @@unique([benchmarkId, date])
  @@map("benchmark_prices")
}

// ---------------------------------------------------------------------------
// Snapshots (monitoring) — written only for the current, real portfolio
// state (never for What If / Simulator / Optimization previews — spec §26).
// ---------------------------------------------------------------------------

model PortfolioSnapshot {
  id             String   @id @default(cuid())
  portfolioId    String
  timestamp      DateTime @default(now())
  portfolioValue Decimal  @db.Decimal(20, 4)
  investedValue  Decimal  @db.Decimal(20, 4)
  cash           Decimal  @db.Decimal(20, 4)
  profitLoss     Decimal  @db.Decimal(20, 4)

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId, timestamp])
  @@map("portfolio_snapshots")
}

model RiskSnapshot {
  id                       String   @id @default(cuid())
  portfolioId              String
  timestamp                DateTime @default(now())

  riskScore                Float
  concentrationScore       Float
  riskContributionScore    Float
  correlationScore         Float
  volatilityScore          Float
  drawdownScore            Float

  volatility               Float
  drawdown                 Float

  largestPositionTicker    String?
  largestPositionWeight    Float?
  top3Concentration        Float?

  topRiskContributorTicker String?
  topRiskContributionPct   Float?
  topRcMinusWeight         Float?

  highestCorrelationPair   String?
  highestCorrelationValue  Float?
  highCorrelationPairs     Json?
  riskDrivers              Json?

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId, timestamp])
  @@map("risk_snapshots")
}

model SavedScenario {
  id                    String   @id @default(cuid())
  portfolioId           String
  name                  String
  weights               Json
  riskScore             Float
  volatility            Float
  drawdown              Float
  concentrationScore    Float
  riskContributionScore Float
  correlationScore      Float
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
  @@map("saved_scenarios")
}

model WatchlistItem {
  id          String   @id @default(cuid())
  userId      String
  securityId  String
  targetPrice Decimal? @db.Decimal(24, 8)
  notes       String?
  createdAt   DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  security Security @relation(fields: [securityId], references: [id], onDelete: Cascade)

  @@unique([userId, securityId])
  @@map("watchlist_items")
}

model InvestmentPlan {
  id                String   @id @default(cuid())
  portfolioId       String   @unique
  monthlyAmount     Decimal  @db.Decimal(20, 4)
  targetAllocation  Json
  rules             Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@map("investment_plans")
}

enum AlertType {
  RISK_SCORE_INCREASE
  CONCENTRATION_INCREASE
  RISK_CONTRIBUTION_INCREASE
  NEW_HIGH_CORRELATION_PAIR
  VOLATILITY_INCREASE
  DRAWDOWN_DETERIORATION
  NEW_RISK_DRIVER
}

model AlertPreference {
  id          String    @id @default(cuid())
  portfolioId String
  alertType   AlertType
  enabled     Boolean   @default(true)
  threshold   Float?

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, alertType])
  @@map("alert_preferences")
}
