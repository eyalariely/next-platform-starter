# Smart Folio — Environment Variables
# Copy this file to .env (or .env.local) and fill in real values.
# All secrets here are server-side only (spec §62) — never prefix a secret
# with NEXT_PUBLIC_.

# --- Database (required now) ---------------------------------------------
# PostgreSQL connection string used by Prisma. A free Supabase/Neon/Railway
# Postgres instance works fine for development.
DATABASE_URL="postgresql://user:password@localhost:5432/smart_folio"

# --- Auth.js (required now) -----------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=""
# Base URL of the deployed app. Auth.js infers this in most hosts; set
# explicitly if callbacks misbehave behind a proxy.
# AUTH_URL="http://localhost:3000"

# --- Market Data provider (TODO: missing key — abstraction is in place,
# see src/lib/market/, but no live provider is wired until a key is added) -
# Any provider can be plugged in behind the MarketDataProvider interface
# (spec §6). Examples: Alpha Vantage, Twelve Data, Financial Modeling Prep,
# Polygon.io.
MARKET_DATA_PROVIDER="" # e.g. "alpha_vantage"
MARKET_DATA_API_KEY=""

# --- AI layer (TODO: missing key — the /advisor page and AI explanation
# layer (spec §44-46) will be built in stage 10 and need this) -------------
AI_PROVIDER="anthropic"
AI_API_KEY=""

# --- Misc -------------------------------------------------------------------
NODE_ENV="development"
