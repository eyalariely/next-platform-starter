# Smart Folio — Environment Variables
# Copy this file to .env (or .env.local) and fill in real values.
# All secrets here are server-side only (spec §62) — never prefix a secret
# with NEXT_PUBLIC_.

# --- Database (required now) ---------------------------------------------
# PostgreSQL connection string used by Prisma. A free Supabase/Neon/Railway
# Postgres instance works fine for development.
DATABASE_URL="postgresql://user:password@localhost:5432/smart_folio"

# --- Auth.js (required now) -----------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=""
# Base URL of the deployed app. Auth.js infers this in most hosts; set
# explicitly if callbacks misbehave behind a proxy.
# AUTH_URL="http://localhost:3000"

# --- Market Data provider (TODO: missing key) ------------------------------
# Abstraction lives in src/lib/market/ (MarketDataProvider interface); any
# provider can be plugged in behind it (spec §6) by adding one adapter file.
# Default/first adapter: Alpha Vantage (https://www.alphavantage.co/support/#api-key
# — free tier key). Without a key set, development falls back automatically
# to a deterministic mock provider (src/lib/market/providers/mock.ts) —
# NEVER used in production (the app throws instead of silently using fake
# data if MARKET_DATA_API_KEY is missing when NODE_ENV=production).
MARKET_DATA_PROVIDER="alpha_vantage"
MARKET_DATA_API_KEY=""

# How long a cached "current" quote is considered fresh before Smart Folio
# calls the provider again, in seconds (spec §7).
MARKET_DATA_QUOTE_TTL_SECONDS="900"

# --- AI layer (TODO: missing key — the /advisor page and AI explanation
# layer (spec §44-46) will be built in stage 10 and need this) -------------
AI_PROVIDER="anthropic"
AI_API_KEY=""

# --- Misc -------------------------------------------------------------------
NODE_ENV="development"
